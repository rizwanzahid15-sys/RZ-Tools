<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert Line to Conduit" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="Conduit type" FontWeight="SemiBold"/>
        <ComboBox x:Name="ctype" Height="24" Margin="0,4,0,10"/>

        <TextBlock Text="Diameter (mm)" FontWeight="SemiBold"/>
        <TextBox x:Name="diameter" Height="24" Margin="0,4,0,10"/>

        <TextBlock Text="Middle elevation above the view's level (mm)" FontWeight="SemiBold"/>
        <TextBox x:Name="elevation" Height="24" Margin="0,4,0,10"/>

        <CheckBox x:Name="fittings" Margin="0,0,0,10"
                  Content="Add elbows / couplings where lines touch"/>

        <TextBlock x:Name="error" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Convert" Width="90" Height="26" Margin="0,0,8,0" IsDefault="True" Click="ok_click"/>
            <Button Content="Cancel" Width="90" Height="26" IsCancel="True" Click="cancel_click"/>
        </StackPanel>
    </StackPanel>
</Window>
