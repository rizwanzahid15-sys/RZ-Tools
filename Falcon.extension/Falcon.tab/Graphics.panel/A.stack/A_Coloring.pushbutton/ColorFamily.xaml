<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falcon - Coloring - Color Family"
        Width="900" Height="580" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Pick a family or one of its types, then press Choose color and pick the color in Revit's color dialog."/>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <TextBox x:Name="search" DockPanel.Dock="Top" Height="24" Margin="0,0,0,6"
                     TextChanged="search_changed" ToolTip="Search families and types"/>
            <CheckBox x:Name="only_used" DockPanel.Dock="Top" Margin="0,0,0,6" IsChecked="True"
                      Content="Only families that are used in the project"
                      Checked="filter_changed" Unchecked="filter_changed"/>
            <TreeView x:Name="tree"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="Selected" FontWeight="Bold"/>
            <TextBlock x:Name="selected_text" Text="Nothing selected" TextWrapping="Wrap" Margin="0,2,0,10"/>
            <CheckBox x:Name="also_3d" Content="Also apply in 3D views"/>
            <TextBlock Margin="20,2,0,12" TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                       Text="Off by default: the color is not shown in 3D views, only in the other views and their templates."/>
            <Button x:Name="choose_btn" Content="Choose color..." Height="30" Margin="0,0,0,8" Click="choose_click"/>
            <Button x:Name="remove_btn" Content="Remove color from selected" Height="26" Margin="0,0,0,8" Click="remove_click"/>
            <Button x:Name="remove_all_btn" Content="Remove all Coloring colors" Height="26" Click="remove_all_click"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Button x:Name="close_btn" DockPanel.Dock="Right" Content="Close" Width="90" Height="26" Click="close_click"/>
            <TextBlock x:Name="status" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
